[
  {
    "id": "out-of-memory",
    "all": [
      "java.lang.OutOfMemoryError"
    ],
    "title": "内存不足",
    "detail": "当前分配的内存不足以载入此世界或模组组合。请在实例设置中提高内存上限。"
  },
  {
    "id": "java-too-old",
    "all": [
      "UnsupportedClassVersionError"
    ],
    "title": "Java 版本过低",
    "detail": "此版本或其模组要求更高的 Java 版本。请清除实例设置中手动指定的 Java 路径，改用自动选择。"
  },
  {
    "id": "missing-mod-dependency",
    "any": [
      "Missing or unsupported mandatory dependencies",
      "requires a version of",
      "Mod resolution encountered an incompatible mod set"
    ],
    "title": "模组依赖缺失",
    "detail": "部分模组缺少前置模组，或前置版本不匹配。详见崩溃报告中的依赖列表。"
  },
  {
    "id": "duplicate-mods",
    "any": [
      "Duplicate mods found",
      "Found a duplicate mod"
    ],
    "title": "模组重复",
    "detail": "mods 目录中存在同一模组的多个版本。请删除多余的版本。"
  },
  {
    "id": "mixin-conflict",
    "all": [
      "org.spongepowered.asm.mixin"
    ],
    "any": [
      "MixinApplyError",
      "InvalidInjectionException",
      "MixinTransformerError"
    ],
    "title": "模组冲突",
    "detail": "多个模组修改了同一处代码，通常由版本不匹配引起。崩溃报告中首个出现的模组可能性最高。"
  },
  {
    "id": "graphics-driver",
    "any": [
      "Failed to initialize GLFW",
      "GLFW error during init",
      "Pixel format not accelerated",
      "Failed to create window",
      "GLFW error 65542",
      "No OpenGL context found",
      "OpenGL 1.1 or higher"
    ],
    "title": "图形环境不可用",
    "detail": "无法获取可用的 OpenGL 环境。请更新显卡驱动；双显卡设备需确认游戏使用独立显卡。远程桌面与无显示器环境不支持运行。"
  },
  {
    "id": "corrupt-files",
    "any": [
      "ZipException",
      "Invalid or corrupt jarfile",
      "error in opening zip file"
    ],
    "title": "文件损坏",
    "detail": "存在未完整下载的文件。请执行「校验文件」，损坏的文件将重新下载。"
  },
  {
    "id": "port-or-network",
    "any": [
      "java.net.BindException",
      "Address already in use"
    ],
    "title": "端口被占用",
    "detail": "游戏所需端口已被其他程序占用，通常是上一次的游戏进程尚未退出。"
  }
]
