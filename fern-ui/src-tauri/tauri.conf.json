{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fern",
  "version": "0.1.1-beta.5",
  "identifier": "dev.fern.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Fern",
        "width": 960,
        "height": 624,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://cdn.modrinth.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/macos/compiled/Fern.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1RkIyODVGNENBNjYxQjgKUldTNFlhWk1YeWo3RllFODNiZmExSU9ORFBxMlBKWVlIYi9hK1FVandvVzFrM2dTTHVVeVBKU0UK",
      "endpoints": [
        "https://dl.fern.huanchengfly.top/stable/manifest.json"
      ]
    }
  }
}
